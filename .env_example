# Discord
DISCORD_TOKEN=seu_token_aqui
CLIENT_ID=id_do_seu_bot_aqui
GUILD_ID=id_do_seu_servidor_aqui

# Canal onde o taskboard será exibido
TASKBOARD_CHANNEL_ID=id_do_canal_taskboard

#Canal onde os líderes receberão notificações de novas tarefas
APPROVAL_CHANNEL_ID=id_do_canal_aprovacao

# Cargo(s) de líder que podem aprovar/rejeitar tarefas (separados por vírgula)
LEADER_ROLE_IDS=id_cargo_lider1,id_cargo_lider2

#Cargos(s) de Staff que ´podem criar tarefas (separados por virgula)
STAFF_ROLE_IDS=id_cargo_staff1,id_cargo_staff2

# Firebase — cole o conteúdo do serviceAccountKey.json aqui como string JSON
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
